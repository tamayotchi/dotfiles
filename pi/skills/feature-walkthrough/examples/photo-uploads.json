            {
              "short": "Recap",
              "chapter": "recap",
              "title": "Recap",
              "body": [
                "<ul class=\"takeaways\"><li>Keep large bytes <b>off the API</b>: presigned URLs, scoped and short-lived.</li><li>Track every upload with a <b>status row</b> and verify on complete.</li><li>Do slow work <b>asynchronously</b> behind a queue.</li><li>Retry with <b>backoff</b>; park poison jobs in a <b>DLQ</b>.</li><li>Serve reads from a <b>CDN</b> with immutable URLs.</li></ul>"
              ],
