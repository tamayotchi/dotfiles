                        "icon": "alert"
                      }
                    ]
                  },
                  "worker": {
                    "dead": 1,
                    "tags": [
                      {
                        "text": "crash loop · same job",
                        "tone": "red",
                        "icon": "skull"
                      }
                    ]
                  }
                },
                "links": {
                  "ua": true,
                  "us": true,
                  "ad": true,
                  "sq": true,
                  "qw": {
                    "fail": 1
                  }
                },
                "flows": [
                  {
                    "route": [
                      "us"
                    ],
                    "kind": "heavy",
                    "rate": 1,
                    "bounce": true
