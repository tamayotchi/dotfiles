            {
              "short": "Crash",
              "chapter": "problem",
              "title": "A bad photo crashes the worker",
              "body": [
                "One corrupted HEIC file makes the resize library crash. The worker restarts, takes the <b>same</b> job, and crashes again — forever.",
                "Meanwhile the queue keeps growing. Uploads still succeed, but nobody's photos get thumbnails."
              ],
              "callout": {
                "kind": "warn",
                "text": "A single “poison message” can stall a whole queue if every failure is retried immediately and indefinitely."
              },
              "changes": [
                "− Worker crash-looping",
                "~ Queue backlog 0 → 12k",
                "~ Thumbnails stuck"
              ],
              "metrics": {
                "p99": 1400,
                "ok": 99,
                "cpu": 24,
                "lag": {
                  "value": "stuck",
                  "level": "bad"
                }
              },
              "scene": {
